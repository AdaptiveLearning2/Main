# App
APP_NAME=EEG Learning Platform
APP_ENV=development
LOG_LEVEL=INFO

# API
HOST=127.0.0.1
PORT=8000

# Security
SECRET_KEY=replace-me-with-a-long-random-string
API_TOKEN=replace-me-learner-token
ADMIN_TOKEN=replace-me-admin-token
ALLOWED_ORIGINS=http://localhost:3000

# Data
DATA_RETENTION_DAYS=30
WS_HEARTBEAT_SECONDS=5
EEG_SAMPLE_HZ=4
EEG_SOURCE=muse
MUSE_BRIDGE_HOST=127.0.0.1
MUSE_BRIDGE_PORT=8765
MUSE_BRIDGE_TIMEOUT_SECONDS=5

# Optional: serve a built SPA from the same PORT as the API (leave unset if the UI runs separately).
# STATIC_SITE_DIR=dist
