node_modules/
package-lock.json
package.json

# Virtualenvs, unanchored so they match in any subproject. Deliberately not "env/".
.venv/
venv/

# Coverage output from `npm run test:coverage`.
coverage/

# Personal manual-QA document; anchored, since it is one file at the repo root.
/MANUAL_QA_CHECKLIST.md

# rPPG capture output and model weights (the scripts' --out defaults, relative to the cwd,
# hence unanchored). The model is named, not *.onnx, which would hide a deliberate one.
emotion-ferplus-8.onnx
rppg_test_output.json
session_fusion_output.json
session_signals_raw.json
fusion_output*.json
session_report.html
.rppg_export_*.tmp

# Python bytecode, at any depth.
__pycache__/
*.pyc

# Claude Code's per-developer settings (absolute local paths). Only this file:
# settings.json and launch.json may legitimately be committed.
.claude/settings.local.json

# Serena's per-machine index and config; all tool-written, including project.yml.
# Here as well as in global ignores, because a global rule stops nothing once a file is tracked.
.serena/

# Editor state; machine-specific paths.
.vscode/
.idea/
