# Backend environment example
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
BACKEND_PORT=8000

# Only for EEG/Muse features; the backend boots without them. Must match
# API_TOKEN/ADMIN_TOKEN in EEGResearch/.env.
EEG_API_TOKEN=replace-me-with-eegresearch-API_TOKEN
EEG_ADMIN_TOKEN=replace-me-with-eegresearch-ADMIN_TOKEN

# Learning-strategies model pass; on/off is the `strategy_llm_enabled` feature flag.
STRATEGY_LLM_MODEL=llama3.1:8b
# Seconds before the model call is abandoned and the rule-based answer stands.
STRATEGY_LLM_TIMEOUT=20
# Process-wide cap on requests waiting on the model; past it the rule-based answer stands.
STRATEGY_LLM_MAX_WAITERS=4

# Per-caller: STRATEGY_RATE_LIMIT requests per STRATEGY_RATE_WINDOW seconds, per worker.
STRATEGY_RATE_LIMIT=10
STRATEGY_RATE_WINDOW=60

# Same four bounds for /api/students/{id}/chart-summary (flag: `chart_summary_llm_enabled`).
CHART_SUMMARY_LLM_MODEL=llama3.1:8b
CHART_SUMMARY_LLM_TIMEOUT=20
CHART_SUMMARY_MAX_WAITERS=4
CHART_SUMMARY_RATE_LIMIT=10
CHART_SUMMARY_RATE_WINDOW=60


# ─── model provider ──────────────────────────────────────────────────────
# Every model call goes through backend/llm_client.py.

# `ollama` (default) or `claude`. ANTHROPIC_API_KEY alone does not opt in to billing.
LLM_PROVIDER=ollama

# Required when LLM_PROVIDER=claude. Real value goes in .env (gitignored), never here.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Undated alias on purpose; pin a snapshot only after confirming it via GET /v1/models.
CLAUDE_MODEL=claude-haiku-4-5

# Claude's range is 0.0-1.0 (call sites pass Ollama's 1.1); clamped to it.
CLAUDE_TEMPERATURE=1.0

# 0: call sites already retry 3x, and only they can reject a wrong-shaped reply.
CLAUDE_MAX_RETRIES=0

# Questions pre-generated per student. 0 = off (default): a spend decision, since
# unanswered queued questions are still billed; the cost of 0 is inline latency.
QUESTION_QUEUE_SIZE=0

# ─── generation bounds ───────────────────────────────────────────────────
# Per-call deadline, seconds (the SDK default is ten minutes).
GENERATION_LLM_TIMEOUT=30

# Process-wide concurrent generations.
GENERATION_MAX_CONCURRENCY=8

# Per-student volume over time.
GENERATION_RATE_LIMIT=60
GENERATION_RATE_WINDOW=60

# Process-wide requests *waiting* on a generation; protects the shared threadpool.
# Past the cap the request is refused (503).
GENERATION_MAX_WAITERS=12

# Claude only. Daily ceiling in CALLS (two per question served); breach is a 503,
# never a silent fallback. In-process: per worker, reset on restart.
GENERATION_DAILY_CALL_LIMIT=2500

# Seconds per sympy solve (killable subprocess). Covers subprocess startup
# (~0.8s), so don't lower it much.
SOLVE_TIMEOUT=3

# Times one solve at boot and raises SOLVE_TIMEOUT to 3x startup if needed.
# Never refuses to start. Turn off only for a process that never solves.
SOLVE_STARTUP_PROBE=1

# ─── the network edge ────────────────────────────────────────────────────

# Publishes /docs, /redoc, /openapi.json. production/prod -> off; development/dev/
# local/test/ci or unset -> on; anything else -> OFF, with a [config] line.
ENV=development

# Comma-separated origins allowed to read responses. Unset -> local frontend;
# production MUST set the real frontend origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest JSON body for an ordinary endpoint.
MAX_BODY_BYTES=262144

# /api/signals/* body cap is INGEST_MAX_BATCH x this (derived, so it scales with the batch bound).
INGEST_MAX_SAMPLE_BYTES=4096

# Per-address budgets per minute for the four routes that resolve no caller.
# An address is a school, not a student: sized above a class behind one NAT.
PUBLIC_READ_RATE_LIMIT=1800
PUBLIC_READ_RATE_WINDOW=60

# Sidecar health probe's own budget: 12/min per open lesson, so 150 lessons per address.
PUBLIC_PROBE_RATE_LIMIT=1800
PUBLIC_PROBE_RATE_WINDOW=60

# Proxies in front of this process. 0 = ignore X-Forwarded-For (right with none).
# Behind a proxy, set the real count or every caller shares one bucket.
TRUSTED_PROXY_HOPS=0
