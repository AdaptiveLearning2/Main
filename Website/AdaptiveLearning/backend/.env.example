# Backend environment example
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
BACKEND_PORT=8000

# Required only to use EEG/Muse features (session start/stop, live state,
# headband control) -- the backend boots fine without these for frontend or
# Supabase-only work. Must match the API_TOKEN/ADMIN_TOKEN configured for the
# EEGResearch sidecar service (EEGResearch/.env); this backend authenticates
# to it as a client.
EEG_API_TOKEN=replace-me-with-eegresearch-API_TOKEN
EEG_ADMIN_TOKEN=replace-me-with-eegresearch-ADMIN_TOKEN

# The opt-in local-model pass over the at-home learning strategies
# (/api/students/{id}/learning-strategies) is no longer configured here: it is
# the `strategy_llm_enabled` row in `feature_flags`, flipped from the admin
# dashboard, so it takes effect without a redeploy. Off by default, and off is
# what CI and any deployment without a local Ollama want.
STRATEGY_LLM_MODEL=llama3.1:8b
# Seconds before the model call is abandoned and the rule-based answer stands.
# A stalled Ollama server never raises on its own, so this is what keeps the
# endpoint from holding a worker thread open indefinitely.
STRATEGY_LLM_TIMEOUT=20
# How many requests may wait on the model at once, process-wide. This endpoint
# is a sync def, so each waiter holds one of the app's shared threadpool slots
# for up to STRATEGY_LLM_TIMEOUT seconds -- the per-caller rate limit above
# does not bound this, since it is per user id. Past the cap the model pass is
# skipped and the rule-based answer stands, which is the same outcome a
# rejected or timed-out reply already produces.
STRATEGY_LLM_MAX_WAITERS=4

# Per-caller ceiling on /api/students/{id}/learning-strategies: at most
# STRATEGY_RATE_LIMIT requests per STRATEGY_RATE_WINDOW seconds, over 429.
# It is the heaviest endpoint a click can trigger, and the button is
# repeatable. Counted in-process, so with multiple workers the effective
# ceiling is this many per worker.
STRATEGY_RATE_LIMIT=10
STRATEGY_RATE_WINDOW=60

# The same four bounds for /api/students/{id}/chart-summary, which rephrases
# the deterministic summary of a student's report charts. Its on/off switch is
# the `chart_summary_llm_enabled` row in `feature_flags`, like the one above.
# The deterministic summary is always the fallback, so every bound here costs
# plainer wording rather than an error.
CHART_SUMMARY_LLM_MODEL=llama3.1:8b
CHART_SUMMARY_LLM_TIMEOUT=20
CHART_SUMMARY_MAX_WAITERS=4
CHART_SUMMARY_RATE_LIMIT=10
CHART_SUMMARY_RATE_WINDOW=60


# ─── model provider ──────────────────────────────────────────────────────
#
# Every model call in the backend -- the 13 question-generation call sites and
# the learning-strategies pass -- goes through backend/llm_client.py, so this
# group is the whole switch.

# `ollama` (default) or `claude`. Deliberately defaults to ollama: a fresh
# checkout running start.ps1 must not begin billing an Anthropic account, so a
# deployment opts in explicitly. Setting ANTHROPIC_API_KEY alone does nothing.
LLM_PROVIDER=ollama

# Required when LLM_PROVIDER=claude. Get one from console.anthropic.com ->
# Settings -> API Keys. Put the real value in .env, never here -- .env is
# gitignored (Website/AdaptiveLearning/.gitignore: *.env) and this file is not.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# The undated alias, deliberately -- see llm_client.py for the full reasoning.
# Short version: a dated snapshot would protect the CLAUDE.md measurements
# from the alias moving, but an unverified dated string 404s every call, and
# the alias resolves either way. Pin a snapshot only after confirming it
# exists via GET /v1/models under a real key.
CLAUDE_MODEL=claude-haiku-4-5

# Anthropic's temperature range is 0.0-1.0 and every generation call site
# passes Ollama's 1.1, which would 400 every request -- so the Claude branch
# takes its own value, floored at 0.0 and capped at 1.0.
CLAUDE_TEMPERATURE=1.0

# 0, against the SDK's own default of 2. Each call site already wraps itself in
# a 3-attempt loop, so the defaults multiply to nine billed attempts per failed
# generation -- and only the call-site loop can reject a well-formed reply for
# being the wrong shape.
CLAUDE_MAX_RETRIES=0

# How many questions to pre-generate per student, served ahead of demand.
#
# 0 = off, and that is the default because it is a spend decision rather than a
# tuning one: a queued question is billed when it is generated but only earns
# its cost when a student actually answers it, so any depth > 0 pays for the
# unanswered questions of every student who closes the tab. The cost of 0 is
# latency -- every question is then generated inline, so the student waits for
# a model call rather than being served instantly from the queue.
QUESTION_QUEUE_SIZE=0

# ─── generation bounds ───────────────────────────────────────────────────
#
# Question generation is on the hottest path in the product and had none of
# these while a local Ollama was free. Per-call deadline; the SDK's own default
# is ten minutes, and a prefetch worker blocked that long never refills a queue.
GENERATION_LLM_TIMEOUT=30

# Process-wide, not per user: _prefetch_active bounds concurrency per student,
# so without this the peak was however many children pressed start at once.
GENERATION_MAX_CONCURRENCY=8

# Per-student volume over time, which the in-flight queue does not bound.
GENERATION_RATE_LIMIT=60
GENERATION_RATE_WINDOW=60

# How many requests may be *waiting* on a generation at once, process-wide --
# a different quantity from MAX_CONCURRENCY above, and the one that protects
# the app. The concurrency semaphore is acquired in the caller's own thread and
# FastAPI runs these sync endpoints on anyio's shared ~40-slot threadpool, so
# without this a class starting together sleeps in those slots for up to
# GENERATION_LLM_TIMEOUT and the signal-ingest endpoints queue behind them.
# Past the cap the request is refused (503) rather than queued.
GENERATION_MAX_WAITERS=12

# Spend ceiling, Claude only -- Ollama is local and free, so a ceiling there
# would refuse a child a question to protect nothing. On breach the request is
# refused (503), never quietly served from the bank or a cheaper model: that
# would change what a child is asked with nothing on any surface saying so.
#
# Counted in CALLS, and a question served is two of them (decide, then
# generate). 2500 covers a class of 30 answering 30 questions a day (~1800
# calls) with room for retries.
# Size it against the worst case, not the average: max_tokens=2048 at Haiku
# 4.5's $5/MTok makes one call cost up to ~$0.0102, so this is ~$15/day at the
# ceiling against a ~$0.0023-per-question average. In-process, so several
# uvicorn workers multiply it and a restart resets the window.
GENERATION_DAILY_CALL_LIMIT=2500

# Wall-clock bound on one sympy parse/solve, which runs in a killable
# subprocess because a runaway one cannot be stopped in-process.
#
# It bounds the worst case, not the normal one: a generator retries three
# times, so a reply that hangs costs ~9s rather than ~30s at the old 10s.
#
# It does NOT affect a normal question. That cost is starting the subprocess
# and importing sympy -- ~0.8s, paid on every solve whatever this is set to.
#
# Careful lowering it: the budget covers the child process including that
# import, so a legitimate solve measures 0.64-1.00s wall (the arithmetic
# itself is ~10ms). 3s is ~3x margin over startup, not 300x over the maths.
SOLVE_TIMEOUT=3

# Whether to measure the solve subprocess's startup cost once at boot.
#
# On (default), it times a trivial solve and raises SOLVE_TIMEOUT for this
# process if the configured value is under 3x that cost -- because the timeout
# covers the child process, and startup is ~99% of what an ordinary solve
# spends. Without it, a machine slower than the one the default was measured on
# fails EVERY question that needs a solve, and the symptom reads as the model
# being unable to write solvable maths rather than as this setting.
#
# It clamps up and logs; it never refuses to start. Costs ~0.8s of boot, once.
# Turn it off only for a process that imports the module and never solves.
SOLVE_STARTUP_PROBE=1

# ─── the network edge ────────────────────────────────────────────────────

# Whether the interactive API docs are published: /docs, /redoc, /openapi.json.
#
#   production, prod                      -> off
#   development, dev, local, test, ci     -> on
#   unset or blank                        -> on (the ordinary local state)
#   anything else                         -> OFF, with a [config] line saying so
#
# That last row is the one worth reading. An unrecognised value is treated as
# production rather than as development, which is the opposite of how every
# other setting in this file falls back: elsewhere the safe side is the
# feature's own default, here it is publishing less. `ENV=prod` under a plain
# equality check would otherwise serve a map of the whole API in production,
# silently, and a typo in a deploy config is exactly how that happens.
ENV=development

# Comma-separated list of origins allowed to READ a response from this API.
# Replaced `allow_origins=["*"]`, which Starlette served by reflecting whatever
# Origin asked. Unset (or blank) falls back to the local frontend, so a fresh
# checkout works; a production deploy MUST set this to the real frontend origin
# or the first page load is refused at the edge.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest JSON body an ordinary endpoint will accept. Nothing here takes an
# upload, so the biggest legitimate non-ingest body is a profile update; this
# is generous by two orders of magnitude and still refuses a body sent to
# occupy a worker.
MAX_BODY_BYTES=262144

# The three /api/signals/* endpoints get their own, larger bound, and it is
# DERIVED: INGEST_MAX_BATCH x this. A single global cap would have refused real
# sensor data -- a cognitive batch at the full batch bound of 500, with the
# fattest raw.ingestion block the sidecar sends, measures ~637 KiB. The
# allowance is ~3x a measured sample, since `raw` is a free-form dict from a
# process on a student's machine and its size is not ours to predict. Raising
# INGEST_MAX_BATCH therefore raises this bound with it, rather than starting to
# reject batches for a reason nothing in the ingest code mentions.
INGEST_MAX_SAMPLE_BYTES=4096

# Five GET routes never resolve a caller (the question bank, the topic list,
# the sidecar health probe, and question generation), so every other limiter
# here -- all of which key on the signed-in user's id -- simply never runs on
# them. These two budgets key on the caller's address instead, per minute.
#
# An address is a SCHOOL, not a student: a class leaves through one NAT, and
# this app's own Adaptive page polls the health route every 5 s while it is
# open, so sixty students behind one address is 720 requests a minute before
# anyone answers a question. Both numbers sit above that on purpose. They
# refuse a runaway or hostile client; they are not a way to police a class.
# Tighten the generation one first if this ever needs revisiting -- that is
# the path that spends a model call.
PUBLIC_GENERATE_RATE_LIMIT=600
PUBLIC_GENERATE_RATE_WINDOW=60
PUBLIC_READ_RATE_LIMIT=1800
PUBLIC_READ_RATE_WINDOW=60

# The sidecar health probe gets its own budget rather than sharing the one
# above. Every open lesson polls it every 5 s, so it is the largest consumer of
# any budget it shares and the first thing an unrelated burst would starve --
# and while it is refused, no lesson can tell whether the headband is there.
# Sized off its own poll: 12/min per open lesson, so this is 150 of them behind
# one address.
PUBLIC_PROBE_RATE_LIMIT=1800
PUBLIC_PROBE_RATE_WINDOW=60

# How many proxies sit in front of this process. 0 means X-Forwarded-For is
# not read at all and the peer address is used, which is right when nothing is
# in front: the header is written by the caller, so trusting it would let one
# client hold as many allowances as it likes. Set it to the real number once
# there is a load balancer or CDN -- left at 0 behind one, every caller in the
# world shares the proxy's address and the first burst locks out everybody.
# Entries are trustworthy only from the right, so this is a count, not a flag.
TRUSTED_PROXY_HOPS=0
