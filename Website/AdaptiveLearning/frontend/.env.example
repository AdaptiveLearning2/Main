VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_API_URL=http://localhost:8000
VITE_EEG_DEBUG=true

# Push ingestion only. The browser calls the sidecar on this machine directly,
# because a hosted backend has no route to a student's laptop.
VITE_EEG_LOCAL_URL=http://127.0.0.1:8001
# The sidecar's learner token (its API_TOKEN). This ships in the client bundle
# and that is deliberate: the sidecar binds to loopback, so the token is useless
# from any other machine. It is not the student's credential -- that one is
# fetched per call from the Supabase session and never lands in a build.
VITE_EEG_LOCAL_TOKEN=replace-me-learner-token
