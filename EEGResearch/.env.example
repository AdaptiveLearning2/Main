# App
APP_NAME=EEG Learning Platform
APP_ENV=development
LOG_LEVEL=INFO

# Server — EEGResearch runs on port 8001
HOST=127.0.0.1
PORT=8001

# Security — replace both tokens before running
API_TOKEN=replace-me-learner-token
ADMIN_TOKEN=replace-me-admin-token

# CORS — include all origins that need access to this service
# Frontend :5173 (Vite), website backend :8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# EEG source: "sim" for local testing without hardware, "muse" for live headband
EEG_SOURCE=sim

# How many EEG samples the stream manager processes per second
EEG_SAMPLE_HZ=4

# Native bridge connection (only used when EEG_SOURCE=muse)
MUSE_BRIDGE_HOST=127.0.0.1
MUSE_BRIDGE_PORT=8765
MUSE_BRIDGE_TIMEOUT_SECONDS=5

# Optional: serve a built SPA from the same port as the API (leave unset if the UI runs separately)
# STATIC_SITE_DIR=dist
