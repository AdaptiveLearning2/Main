# Backend environment example
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
BACKEND_PORT=8000

# Required only to use EEG/Muse features (session start/stop, live state,
# headband control) -- the backend boots fine without these for frontend or
# Supabase-only work. Must match the API_TOKEN/ADMIN_TOKEN configured for the
# EEGResearch sidecar service (EEGResearch/.env); this backend authenticates
# to it as a client.
EEG_API_TOKEN=replace-me-with-eegresearch-API_TOKEN
EEG_ADMIN_TOKEN=replace-me-with-eegresearch-ADMIN_TOKEN

# The opt-in local-model pass over the at-home learning strategies
# (/api/students/{id}/learning-strategies) is no longer configured here: it is
# the `strategy_llm_enabled` row in `feature_flags`, flipped from the admin
# dashboard, so it takes effect without a redeploy. Off by default, and off is
# what CI and any deployment without a local Ollama want.
STRATEGY_LLM_MODEL=llama3.1:8b
# Seconds before the model call is abandoned and the rule-based answer stands.
# A stalled Ollama server never raises on its own, so this is what keeps the
# endpoint from holding a worker thread open indefinitely.
STRATEGY_LLM_TIMEOUT=20
# How many requests may wait on the model at once, process-wide. This endpoint
# is a sync def, so each waiter holds one of the app's shared threadpool slots
# for up to STRATEGY_LLM_TIMEOUT seconds -- the per-caller rate limit above
# does not bound this, since it is per user id. Past the cap the model pass is
# skipped and the rule-based answer stands, which is the same outcome a
# rejected or timed-out reply already produces.
STRATEGY_LLM_MAX_WAITERS=4

# Per-caller ceiling on /api/students/{id}/learning-strategies: at most
# STRATEGY_RATE_LIMIT requests per STRATEGY_RATE_WINDOW seconds, over 429.
# It is the heaviest endpoint a click can trigger, and the button is
# repeatable. Counted in-process, so with multiple workers the effective
# ceiling is this many per worker.
STRATEGY_RATE_LIMIT=10
STRATEGY_RATE_WINDOW=60


# ─── model provider ──────────────────────────────────────────────────────
#
# Every model call in the backend -- the 13 question-generation call sites and
# the learning-strategies pass -- goes through backend/llm_client.py, so this
# group is the whole switch.

# `ollama` (default) or `claude`. Deliberately defaults to ollama: a fresh
# checkout running start.ps1 must not begin billing an Anthropic account, so a
# deployment opts in explicitly. Setting ANTHROPIC_API_KEY alone does nothing.
LLM_PROVIDER=ollama

# Required when LLM_PROVIDER=claude. Get one from console.anthropic.com ->
# Settings -> API Keys. Put the real value in .env, never here -- .env is
# gitignored (Website/AdaptiveLearning/.gitignore: *.env) and this file is not.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# A dated snapshot rather than the `claude-haiku-4-5` alias, on purpose: the
# grade-appropriateness and check-engagement figures in CLAUDE.md are claims
# about one model's output, and an alias moving under them would invalidate
# those numbers without changing a line of code.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Anthropic's temperature range is 0.0-1.0 and every generation call site
# passes Ollama's 1.1, which would 400 every request -- so the Claude branch
# takes its own value, floored at 0.0 and capped at 1.0.
CLAUDE_TEMPERATURE=1.0

# 0, against the SDK's own default of 2. Each call site already wraps itself in
# a 3-attempt loop, so the defaults multiply to nine billed attempts per failed
# generation -- and only the call-site loop can reject a well-formed reply for
# being the wrong shape.
CLAUDE_MAX_RETRIES=0

# How many questions to pre-generate per student, served ahead of demand.
#
# 0 = off, and that is the default because it is a spend decision rather than a
# tuning one: a queued question is billed when it is generated but only earns
# its cost when a student actually answers it, so any depth > 0 pays for the
# unanswered questions of every student who closes the tab. The cost of 0 is
# latency -- every question is then generated inline, so the student waits for
# a model call rather than being served instantly from the queue.
QUESTION_QUEUE_SIZE=0

# ─── generation bounds ───────────────────────────────────────────────────
#
# Question generation is on the hottest path in the product and had none of
# these while a local Ollama was free. Per-call deadline; the SDK's own default
# is ten minutes, and a prefetch worker blocked that long never refills a queue.
GENERATION_LLM_TIMEOUT=30

# Process-wide, not per user: _prefetch_active bounds concurrency per student,
# so without this the peak was however many children pressed start at once.
GENERATION_MAX_CONCURRENCY=8

# Per-student volume over time, which the in-flight queue does not bound.
GENERATION_RATE_LIMIT=60
GENERATION_RATE_WINDOW=60

# How many requests may be *waiting* on a generation at once, process-wide --
# a different quantity from MAX_CONCURRENCY above, and the one that protects
# the app. The concurrency semaphore is acquired in the caller own thread and
# FastAPI runs these sync endpoints on anyio shared ~40-slot threadpool, so
# without this a class starting together sleeps in those slots for up to
# GENERATION_LLM_TIMEOUT and the signal-ingest endpoints queue behind them.
# Past the cap the request is refused (503) rather than queued.
GENERATION_MAX_WAITERS=12

# Spend ceiling, Claude only -- Ollama is local and free, so a ceiling there
# would refuse a child a question to protect nothing. On breach the request is
# refused (503), never quietly served from the bank or a cheaper model: that
# would change what a child is asked with nothing on any surface saying so.
GENERATION_DAILY_CALL_LIMIT=5000
