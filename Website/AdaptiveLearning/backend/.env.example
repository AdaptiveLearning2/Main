# Backend environment example
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
OPENAI_API_KEY=optional_openai_key_here
BACKEND_PORT=8000

# Required only to use EEG/Muse features (session start/stop, live state,
# headband control) -- the backend boots fine without these for frontend or
# Supabase-only work. Must match the API_TOKEN/ADMIN_TOKEN configured for the
# EEGResearch sidecar service (EEGResearch/.env); this backend authenticates
# to it as a client.
EEG_API_TOKEN=replace-me-with-eegresearch-API_TOKEN
EEG_ADMIN_TOKEN=replace-me-with-eegresearch-ADMIN_TOKEN

# Opt-in local-model pass over the at-home learning strategies
# (/api/students/{id}/learning-strategies). Left false, the endpoint answers
# from its fixed rule set and never opens a socket -- which is what CI and any
# deployment without a local Ollama should do. Enabled, model output still has
# to pass the endpoint's safety checks or the rule-based answer is kept.
STRATEGY_LLM_ENABLED=false
STRATEGY_LLM_MODEL=llama3.1:8b
# Seconds before the model call is abandoned and the rule-based answer stands.
# A stalled Ollama server never raises on its own, so this is what keeps the
# endpoint from holding a worker thread open indefinitely.
STRATEGY_LLM_TIMEOUT=20
# How many requests may wait on the model at once, process-wide. This endpoint
# is a sync def, so each waiter holds one of the app's shared threadpool slots
# for up to STRATEGY_LLM_TIMEOUT seconds -- the per-caller rate limit above
# does not bound this, since it is per user id. Past the cap the model pass is
# skipped and the rule-based answer stands, which is the same outcome a
# rejected or timed-out reply already produces.
STRATEGY_LLM_MAX_WAITERS=4

# Per-caller ceiling on /api/students/{id}/learning-strategies: at most
# STRATEGY_RATE_LIMIT requests per STRATEGY_RATE_WINDOW seconds, over 429.
# It is the heaviest endpoint a click can trigger, and the button is
# repeatable. Counted in-process, so with multiple workers the effective
# ceiling is this many per worker.
STRATEGY_RATE_LIMIT=10
STRATEGY_RATE_WINDOW=60
