# Python cache
__pycache__/
*.py[cod]

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
*.env
# ...and anything derived from one. `*.env` does not match `.env.bak`,
# and a hand-made backup of a .env holds exactly the same secrets as
# the file it copies. `git add -A` swept one into a commit; GitHub's
# push protection is what caught it, which is not a control this repo
# owns.
*.env.*
.env.*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


