node_modules/
package-lock.json
package.json

# Virtualenvs. Placed in the top-level .gitignore rather than per-subproject
# because Website/AdaptiveLearning/backend/.venv was missed by the per-directory
# rules and ended up committed -- 4899 files / 55.7MB, including
# platform-specific binaries (python.exe, .pyd) that are wrong for anyone on
# another OS.
#
# The patterns are unanchored (no leading slash) so they match at any depth,
# which is the point -- a venv created in any subproject is covered.
#
# Deliberately only these two names. A broader "env/" would also swallow a
# future config directory called env, and this repo's convention is .venv
# everywhere, so the extra coverage buys nothing.
.venv/
venv/

# Coverage output. `npm run test:coverage` writes 66 files here, and without
# this they all land in git status as untracked -- the same shape of gap that
# put a 4899-file virtualenv in this repo above.
coverage/

# Personal manual-QA working document -- deliberately not part of the shared
# repo. Anchored with a leading slash, unlike the rules above: this is one
# specific file at the repository root, not a name that should match at any
# depth.
/MANUAL_QA_CHECKLIST.md

# rPPG capture output and model weights. The capture script rewrites its whole
# session report every second and downloads a 35MB ONNX model into the working
# directory, so a single run leaves both behind next to the source. An earlier
# branch committed them: ~630k lines of session JSON (one file was 582,612
# lines), the 35MB model, three .pyc, and a .tmp left by a crashed atomic write.
#
# These are the scripts' actual --out defaults, read from the source rather than
# from the README's "Suggested .gitignore" block -- that block listed names no
# script writes any more (facial_session*.json, emotion_rppg_test.json) and
# missed rppg_test_output.json, which is the one that rewrites every second and
# became the 582k-line file. The block has been removed from the README so there
# is one list, here, and no second copy to drift.
#
# Scoped to this directory rather than repo-wide: a blanket *.onnx would also
# silently swallow a small model someone deliberately wants to commit elsewhere.
#
# A non-default --out is not covered. The durable fix is to point every default
# at an ignored output/ directory so one rule covers all of them, but that means
# changing script behaviour and belongs with the port into the sidecar, not with
# a commit whose job is to stop the artifacts being committed.
/FacialRecg/**/*.onnx
/FacialRecg/**/rppg_test_output.json
/FacialRecg/**/session_fusion_output.json
/FacialRecg/**/session_signals_raw.json
/FacialRecg/**/fusion_output*.json
/FacialRecg/**/session_report.html
/FacialRecg/**/.rppg_export_*.tmp

# Python bytecode. Unanchored, like the venv rules above, so it matches at any
# depth rather than only where someone remembered to add a rule.
__pycache__/
*.pyc
