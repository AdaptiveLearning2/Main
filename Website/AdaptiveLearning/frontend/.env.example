VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_API_URL=http://localhost:8000
VITE_EEG_DEBUG=true

# Push ingestion only: the browser calls the sidecar on this machine directly.
VITE_EEG_LOCAL_URL=http://127.0.0.1:8001
# The sidecar's API_TOKEN. Shipping it in the bundle is deliberate: loopback only.
VITE_EEG_LOCAL_TOKEN=replace-me-learner-token
